<!--
  Slide 14 — Risk Assessment
  Type: content-slide
  Required tokens (substituted by render_deck.py from metrics.json):
    For each risk N ∈ {1, 2, 3, 4}:
      {{RISK_N_TEXT}}        Risk description (concise sentence)
      {{RISK_N_SEVERITY}}    Severity label — "High" | "Medium" | "Low"
      {{RISK_N_CONF_CLASS}}  CSS confidence class — "high" | "medium" | "low"
  Required non-text visual: Lucide icons + table
-->
<section class="content-slide">
  <span class="eyebrow">Risk Assessment</span>
  <h3>Known Risks &amp; Confounders</h3>
  <table class="metric-table">
    <thead>
      <tr><th></th><th>Risk</th><th>Severity</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><i data-lucide="alert-triangle"></i></td>
        <td>{{RISK_1_TEXT}}</td>
        <td><span class="confidence-{{RISK_1_CONF_CLASS}}">{{RISK_1_SEVERITY}}</span></td>
      </tr>
      <tr>
        <td><i data-lucide="alert-triangle"></i></td>
        <td>{{RISK_2_TEXT}}</td>
        <td><span class="confidence-{{RISK_2_CONF_CLASS}}">{{RISK_2_SEVERITY}}</span></td>
      </tr>
      <tr>
        <td><i data-lucide="alert-triangle"></i></td>
        <td>{{RISK_3_TEXT}}</td>
        <td><span class="confidence-{{RISK_3_CONF_CLASS}}">{{RISK_3_SEVERITY}}</span></td>
      </tr>
      <tr>
        <td><i data-lucide="alert-triangle"></i></td>
        <td>{{RISK_4_TEXT}}</td>
        <td><span class="confidence-{{RISK_4_CONF_CLASS}}">{{RISK_4_SEVERITY}}</span></td>
      </tr>
    </tbody>
  </table>
</section>
