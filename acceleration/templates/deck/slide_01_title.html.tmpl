      rendered HTML.
-->
<section class="title-slide">
  <span class="eyebrow">Acceleration Analysis · Formbricks</span>
  <h1>Development Acceleration</h1>
  <h2>Baseline vs Post-Introduction</h2>
  <div class="title-meta">
    <p><i data-lucide="calendar"></i> Period: {{DATE_RANGE_HUMAN}}</p>
    <p><i data-lucide="git-branch"></i> Inflection: {{INFLECTION_DATE}} · Method: {{INFLECTION_METHOD}}</p>
    <p><i data-lucide="rocket"></i> Generated: {{GENERATED_TIMESTAMP}}</p>
  </div>
</section>
